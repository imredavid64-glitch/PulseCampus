# PulseCampus Frontend Environment Variables
# Copy to .env.local and fill in your values

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend API URL
# For local development: http://localhost:8000
# For production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Default map center (lat, lng, zoom)
# Default: San Francisco State University area
NEXT_PUBLIC_DEFAULT_LAT=37.7245
NEXT_PUBLIC_DEFAULT_LNG=-122.4773
NEXT_PUBLIC_DEFAULT_ZOOM=16